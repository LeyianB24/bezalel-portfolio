# ==============================================================================
# Bezalel Technologies — Environment Variables Configuration Template
# Copy this file to .env or .env.local and fill in the appropriate secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL / NeonDB)
# ------------------------------------------------------------------------------
# Connection string for Neon Serverless PostgreSQL with SSL enabled
DATABASE_URL="postgresql://username:password@ep-sample-pool.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. NextAuth.js / Authentication
# ------------------------------------------------------------------------------
# Random 32+ character string for signing session JWTs (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your_nextauth_secret_key_here"
# Canonical URL of the application
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google OAuth 2.0 credentials for client sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 3. Seed Administrator Account
# ------------------------------------------------------------------------------
# Used by `npm run prisma:seed` or initial DB setup to provision the root super-admin
SEED_ADMIN_EMAIL="admin@bezalelstudio.com"
SEED_ADMIN_PASSWORD="ChangeMeToAStrongPassword123!"

# ------------------------------------------------------------------------------
# 4. Cloudinary (Media & Asset Storage)
# ------------------------------------------------------------------------------
# Cloudinary cloud name for client-side uploads and Next/Image transformations
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
# Cloudinary API key and secret for server-side signed uploads
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ------------------------------------------------------------------------------
# 5. Resend (Transactional Email)
# ------------------------------------------------------------------------------
# Resend API key for dispatching quotation PDFs, order receipts, and admin alerts
RESEND_API_KEY="re_sample_api_key_here"
# From address verified in your Resend domain settings
EMAIL_FROM="Bezalel Technologies <no-reply@bezalel.website>"
# Admin destination email for receiving project briefs, contact leads, and career notices
ADMIN_EMAIL="bezaleltech@gmail.com"

# ------------------------------------------------------------------------------
# 6. Upstash Redis (Rate Limiting & Telemetry Cache)
# ------------------------------------------------------------------------------
# Upstash REST API URL and Token for distributed rate limiting on public forms/checkout
UPSTASH_REDIS_REST_URL="https://sample-app.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"

# ------------------------------------------------------------------------------
# 7. M-Pesa Daraja 2.0 (Safaricom STK Push Payments)
# ------------------------------------------------------------------------------
# Daraja developer credentials from developer.safaricom.co.ke
MPESA_CONSUMER_KEY="your_mpesa_consumer_key"
MPESA_CONSUMER_SECRET="your_mpesa_consumer_secret"
# Lipa Na M-Pesa Business Shortcode (Paybill or Till Number)
MPESA_SHORTCODE="174379"
# Daraja Lipa Na M-Pesa Online Passkey
MPESA_PASSKEY="your_mpesa_passkey"
# Shared secret for authenticating Safaricom M-Pesa webhook callbacks
MPESA_CALLBACK_SECRET="your_mpesa_callback_secret_here"
# Public HTTPS callback URL for Safaricom confirmation webhooks (must include secret in path or query)
MPESA_CALLBACK_URL="https://bezalel.website/api/webhooks/mpesa/your_mpesa_callback_secret_here"

# ------------------------------------------------------------------------------
# 8. Stripe Payments (International Card Processing)
# ------------------------------------------------------------------------------
# Stripe Secret Key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY="sk_test_sample_key"
# Stripe Webhook Signing Secret (whsec_...) for verifying Stripe event signatures
STRIPE_WEBHOOK_SECRET="whsec_sample_webhook_secret"
# Stripe Publishable Key for client-side Stripe Elements checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_sample_publishable_key"

# ------------------------------------------------------------------------------
# 9. Vercel Blob (Optional Secondary Storage)
# ------------------------------------------------------------------------------
# Read/Write token for Vercel Blob storage
BLOB_READ_WRITE_TOKEN=""
